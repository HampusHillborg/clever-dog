# Known client-side routes map back to index.html so React Router can take
# over. Unknown paths fall through to the 404 response at the end.
#
# Netlify Functions are explicitly served first, then everything else.

/api/*                /.netlify/functions/:splat   200

# Canonical homepage alias.
/staffanstorp         /                              301!

# Public HTML and slash aliases use canonical tags. Netlify normalizes
# trailing slashes in redirect matching; do not redirect /page/ to /page.

# Prerendered public service pages.
/hunddagis            /hunddagis.html               200
/hundpensionat        /hundpensionat.html           200
/priser               /priser.html                  200
/vanliga-fragor       /vanliga-fragor.html           200

# React application routes.
/login                /app-shell.html                  200
/login/*              /app-shell.html                  200
/kund                 /app-shell.html                  200
/kund/*               /app-shell.html                  200
/admin                /app-shell.html                  200
/admin/*              /app-shell.html                  200
/privacy              /app-shell.html                  200
/integritetspolicy    /app-shell.html                  200
/radera-konto         /app-shell.html                  200
/delete-account       /app-shell.html                  200

# Unknown URLs must return a real 404 rather than a soft 404.
/*                    /404.html                    404
